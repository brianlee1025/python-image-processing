ARG PYTHON_VERSION=3.14.7
FROM python:${PYTHON_VERSION}-slim-bookworm@sha256:23c59390fc717bf09f9336908199a0ae75d9c4264bf296123f94ad772fea3b52

ARG UV_VERSION=0.12.5

# The Kafka worker is a plain long running process: no web server, no beat
# schedule, just a consumer loop feeding the render pool.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    WORKER_HEARTBEAT_FILE=/tmp/image-worker-heartbeat

# Cards are drawn, not laid out in a browser, so the face on disk is the face
# on the card. Without this the slim image has no fonts at all and Pillow falls
# back to its bundled 113 glyph face: no en dash, no accented latin, tofu boxes
# wherever a name or a time range needs either.
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "uv==${UV_VERSION}" \
    && groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /nonexistent --shell /usr/sbin/nologin app

# Configure UV to compile bytecode and skip dev dependencies
ENV UV_COMPILE_BYTECODE=1
ENV UV_NO_DEV=1
ENV UV_LINK_MODE=copy
ENV UV_TOOL_BIN_DIR=/usr/local/bin

# Set working directory
WORKDIR /app

# Add venv to PATH
ENV PATH="/app/.venv/bin:$PATH"

# Copy dependency files
COPY pyproject.toml uv.lock README.md LICENSE /app/

# Install dependencies only (cached layer)
RUN uv sync --frozen --no-install-project --python /usr/local/bin/python

# Copy application code
COPY image_processing_service /app/image_processing_service

# Install project
RUN uv sync --frozen --python /usr/local/bin/python

USER app:app

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import os,time; p=os.environ['WORKER_HEARTBEAT_FILE']; raise SystemExit(0 if os.path.exists(p) and time.time()-os.path.getmtime(p)<45 else 1)"]

CMD ["python", "-m", "image_processing_service.worker"]
