# Local development settings. Copy to `.env` and the worker needs no flags:
#
#   cp .env.example .env
#   image_processing_service render-worker
#
# Deployed environments set real environment variables instead; anything set in
# the environment wins over this file.

# playbook-be's local stack already runs Redpanda on 9092. Start it with:
#   docker compose -f ../playbook-be/src/main/resources/docker-compose.yml up -d
KAFKA_BROKERS=localhost:9092
KAFKA_REQUEST_TOPIC=image-render-requests
KAFKA_RESULT_TOPIC=image-render-results
KAFKA_GROUP_ID=image-render-workers

# playbook-be sends presigned MinIO links for avatars and covers, so remote
# fetching has to be on, with only the storage hosts allowed.
RENDER_ALLOW_REMOTE_IMAGES=true
RENDER_REMOTE_IMAGE_HOSTS=["localhost","127.0.0.1","minio"]
RENDER_REMOTE_REQUIRE_HTTPS=false
RENDER_ALLOW_PRIVATE_REMOTE_HOSTS=true

# Renders in flight, and the queue in front of them.
RENDER_WORKERS=4
RENDER_QUEUE_SIZE=32

# Squads and events without a banner get generated cover art. Point this at a
# directory of photographs (files named squad.jpg, event-futsal.jpg, ...) to
# use those instead.
# RENDER_DEFAULT_COVER_DIR=./covers
